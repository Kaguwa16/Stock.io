<div class="login-container">
  <h2>Login Dashboard</h2>
  <form id="loginForm">
    <div class="input-group">
      <label>Email</label>
      <input type="email" id="loginEmail" required placeholder="email@domain.com">
    </div>
    <div class="input-group">
      <label>Password</label>
      <input type="password" id="loginPassword" required placeholder="********">
    </div>
    <button type="submit" id="loginBtn">Masuk</button>
  </form>
</div>

import { getAuth, signInWithEmailAndPassword } from "https://www.gstatic.com/firebasejs/10.x.x/firebase-auth.js";

// Pastikan 'auth' sudah diinisialisasi dari file konfigurasi Firebase utama Anda
const auth = getAuth();

document.getElementById('loginForm').addEventListener('submit', async (e) => {
  e.preventDefault();
  
  const email = document.getElementById('loginEmail').value;
  const password = document.getElementById('loginPassword').value;
  const btn = document.getElementById('loginBtn');
  
  btn.textContent = "Memproses...";
  btn.disabled = true;

  try {
    // Proses login ke Firebase Auth
    const userCredential = await signInWithEmailAndPassword(auth, email, password);
    const user = userCredential.user;
    
    console.log("Login Berhasil:", user.email);
    window.showToast("Login berhasil! Mengalihkan...", "success");
    
    // Alihkan ke halaman dashboard setelah sukses
    setTimeout(() => {
      window.location.href = "dashboard.html"; // Sesuaikan dengan nama file utama Anda
    }, 1000);

  } catch (error) {
    console.error("Error login:", error.code, error.message);
    
    // Terjemahkan pesan error yang umum agar lebih ramah pengguna
    let pesanError = "Gagal login. Periksa kembali email dan password Anda.";
    if (error.code === 'auth/user-not-found') pesanError = "Akun dengan email tersebut tidak ditemukan.";
    if (error.code === 'auth/wrong-password') pesanError = "Password salah.";
    if (error.code === 'auth/invalid-credential') pesanError = "Kredensial login tidak valid.";
    
    window.showToast(pesanError, "error");
    btn.textContent = "Masuk";
    btn.disabled = false;
  }
});

import { getAuth, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/10.x.x/firebase-auth.js";

const auth = getAuth();

onAuthStateChanged(auth, (user) => {
  if (user) {
    // Pengguna sudah login, ambil datanya jika diperlukan
    const uid = user.uid;
    console.log("Sesi aktif untuk user:", uid);
  } else {
    // Pengguna belum login, tendang kembali ke halaman login.html
    window.location.href = "login.html";
  }
});
